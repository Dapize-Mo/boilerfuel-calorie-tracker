# ── Core ────────────────────────────────────────────────────────────────

# Optional API base URL override for local development (see utils/auth.js).
# Leave unset in production — the app calls its own Next.js API routes.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:5000

# Public site URL used for SEO tags and the sitemap
# NEXT_PUBLIC_SITE_URL=https://boiler-calorie-tracker-v3.vercel.app

# Google OAuth Credentials
# Get these from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# NextAuth Configuration
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Admin password required for /api/admin/login
ADMIN_PASSWORD=change-me

# JWT secret for signing admin tokens (defaults to ADMIN_PASSWORD if unset)
# JWT_SECRET_KEY=some-long-random-string

# Database connection (set on Vercel for production)
# POSTGRES_URL=postgresql://user:password@host:port/dbname

# ── Optional / production-only ──────────────────────────────────────────

# Secret required by the Vercel cron endpoint /api/admin/auto-maintenance
# CRON_SECRET=some-long-random-string

# Only used by the optional admin scrape proxy (pages/api/admin/scrape.js)
# to trigger an externally hosted scraper. Not needed otherwise.
# BACKEND_URL=

# Database capacity guard (bytes; see utils/db.js)
# DB_CAPACITY_BYTES=268435456
# DB_PAUSE_THRESHOLD_PERCENT=90
# DB_CAPACITY_STRICT=false

# Days to retain cross-device sync payloads (pages/api/sync.js)
# SYNC_RETENTION_DAYS=30

# Set to "false" only if your Postgres host uses a self-signed certificate
# DB_SSL_REJECT_UNAUTHORIZED=true
